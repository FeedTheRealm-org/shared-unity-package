    <Style src="project://database/Packages/com.feed_the_realm.shared/Runtime/UI/AuthMenu/Themes/AuthForm.uss?fileID=7433441132597879392&amp;guid=c25ac5f0ef9fbfd46bdd96a557e53334&amp;type=3#AuthForm" />
    <ui:VisualElement name="VerifyCodeContainer" class="AuthContainer" style="transition-property: all; transition-duration: 0s; transition-timing-function: ease; transition-delay: 0s; background-image: url(&quot;project://database/Assets/1_FeedTheRealm/UI/MainMenu/Themes/wp11361931-minimalist-3440x1440-wallpapers.png?fileID=2800000&amp;guid=e5485c7df8ed0e812a3174862419d312&amp;type=3#wp11361931-minimalist-3440x1440-wallpapers&quot;);">

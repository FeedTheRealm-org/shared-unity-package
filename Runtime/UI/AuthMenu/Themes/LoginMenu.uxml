<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.feed_the_realm.shared/Runtime/UI/AuthMenu/Themes/AuthForm.uss?fileID=7433441132597879392&amp;guid=c25ac5f0ef9fbfd46bdd96a557e53334&amp;type=3#AuthForm"/>
    <ui:VisualElement name="LoginContainer" class="AuthContainer">
        <ui:VisualElement name="FormLogin" class="formBox">
            <ui:Label text="Login" name="FormTitle" class="AuthFormTitle"/>
            <ui:VisualElement name="FieldsGroup" class="AuthFieldsGroup">
                <ui:TextField label="Email" placeholder-text="Enter your email" name="EmailField" value="" class="AuthEmailInput"/>
                <ui:TextField label="Password" placeholder-text="Enter your password" name="PasswordField" password="true" value="" class="AuthPasswordField"/>
            </ui:VisualElement>
            <ui:Label name="MessageError" class="AuthMessageError"/>
            <ui:Button text="Login" name="LoginButton" class="AuthFormButton"/>
            <ui:Label text="Don't have account? Sign up here" name="SignUpChangeButton" class="AuthChangeButton"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

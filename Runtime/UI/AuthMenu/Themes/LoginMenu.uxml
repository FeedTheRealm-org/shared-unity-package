<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.feed_the_realm.shared/Runtime/UI/AuthMenu/Themes/AuthForm.uss?fileID=7433441132597879392&amp;guid=c25ac5f0ef9fbfd46bdd96a557e53334&amp;type=3#AuthForm"/>
    <ui:VisualElement name="LoginContainer" class="AuthContainer" style="transition-property: all; transition-duration: 0s; transition-timing-function: ease; transition-delay: 0s; background-image: none; background-color: rgba(55, 55, 55, 0); -unity-background-image-tint-color: rgba(255, 166, 165, 0);">
        <ui:VisualElement name="FormLogin" class="formBox" style="flex-direction: column;">
            <ui:TextField label="Email" placeholder-text="Enter your email" name="EmailField" value="" class="AuthEmailInput"/>
            <ui:TextField label="Password" placeholder-text="Enter your password" name="PasswordField" password="true" value="" class="AuthPasswordField"/>
            <ui:Label text="Login" name="FormTitle" class="AuthFormTitle"/>
            <ui:Label text="Don&apos;t have account? Sign up here" name="SignUpChangeButton" class="AuthChangeButton"/>
            <ui:Label name="MessageError" class="AuthMessageError" style="color: rgb(255, 51, 51); display: none; margin-top: 4px; font-size: 13px; align-self: center;"/>
            <ui:Button text="Login" name="LoginButton" class="AuthFormButton"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.feed_the_realm.shared/Runtime/UI/AuthMenu/Themes/AuthForm.uss?fileID=7433441132597879392&amp;guid=c25ac5f0ef9fbfd46bdd96a557e53334&amp;type=3#AuthForm" />
    <ui:VisualElement name="SignUpContainer" class="AuthContainer" style="flex-grow: 1; background-image: url(&quot;project://database/Packages/com.feed_the_realm.shared/Runtime/UI/AuthMenu/Themes/auth_bg.jpg?fileID=2800000&amp;guid=1b1cc05eb2cfed684bf76274a95ddb1f&amp;type=3#auth_bg&quot;); background-color: rgb(81, 111, 144); -unity-background-image-tint-color: rgb(255, 167, 166);">
        <ui:VisualElement name="SignUpForm" class="formBox" style="flex-grow: 1; flex-direction: column;">
            <ui:Label text="Sign Up" name="TitleForm" class="AuthFormTitle" style="top: 3%; left: auto;" />
            <ui:TextField label="Email" placeholder-text="Ingress your email" name="EmailField" class="AuthEmailInput" />
            <ui:TextField label="Password" placeholder-text="Ingress your password" name="PasswordField" password="true" class="AuthPasswordField" />
            <ui:TextField label="Repeat Password" placeholder-text="Ingress your password" name="RepeatPasswordField" password="true" class="AuthPasswordField" />
            <ui:Label text="Already have account? Login here" name="LoginChangeButton" class="AuthChangeButton" style="top: 1%;" />
            <ui:Label name="MessageError" class="AuthChangeButton AuthMessageError" style="top: 1%;" />
            <ui:Button text="Sign Up" name="SignUpButton" class="AuthFormButton" style="bottom: 3%;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

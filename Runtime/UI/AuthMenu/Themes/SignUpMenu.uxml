<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.feed_the_realm.shared/Runtime/UI/AuthMenu/Themes/AuthForm.uss?fileID=7433441132597879392&amp;guid=c25ac5f0ef9fbfd46bdd96a557e53334&amp;type=3#AuthForm"/>
    <ui:VisualElement name="SignUpContainer" class="AuthContainer">
        <ui:VisualElement name="SignUpForm" class="formBox">
            <ui:Label text="Sign Up" name="TitleForm" class="AuthFormTitle"/>
            <ui:VisualElement name="FieldsGroup" class="AuthFieldsGroup">
                <ui:TextField label="Email" placeholder-text="Enter your email" name="EmailField" class="AuthEmailInput"/>
                <ui:TextField label="Password" placeholder-text="Enter your password" name="PasswordField" password="true" class="AuthPasswordField"/>
                <ui:TextField label="Repeat Password" placeholder-text="Enter your password again" name="RepeatPasswordField" password="true" class="AuthPasswordField"/>
            </ui:VisualElement>
            <ui:Label name="MessageError" class="AuthMessageError"/>
            <ui:Button text="Sign Up" name="SignUpButton" class="AuthFormButton"/>
            <ui:VisualElement name="ChangeLoginRow" class="AuthChangeRow">
                <ui:Label text="Already have account?" class="AuthChangeLabel"/>
                <ui:Button text="Back to Log In" name="LoginChangeButton" class="AuthChangeLinkButton"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

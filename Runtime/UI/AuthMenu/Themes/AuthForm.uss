:root {}

.AuthContainer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    /* background-image removed */
    background-color: rgba(0, 0, 0, 0);
}

.formBox {
    width: 28%;
    height: 75%;
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    padding-top: 2%;
    padding-bottom: 2%;
    padding-left: 2%;
    padding-right: 2%;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 7%;
    border-top-right-radius: 7%;
    border-bottom-right-radius: 7%;
    border-bottom-left-radius: 7%;
    overflow: hidden;
}

.AuthFormTitle {
    -unity-text-align: middle-center;
    font-size: 160%;        /* was 120% */
    align-self: center;
    white-space: normal;
    flex-shrink: 1;
}

.AuthEmailInput,
.AuthPasswordField {
    width: 85%;
    align-self: center;
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 1;
}

/* Center the Email / Password labels */
.AuthEmailInput > .unity-label,
.AuthPasswordField > .unity-label {
    -unity-text-align: middle-center;
    align-self: center;
}

.AuthFieldsGroup {
    width: 85%;
    align-self: center;
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 1;
}

.AuthEmailInput,
.AuthPasswordField {
    width: 100%;
    align-self: stretch;
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 1;
    margin-bottom: 8px;
}

.AuthEmailInput > .unity-text-field__input,
.AuthPasswordField > .unity-text-field__input {
    width: 100%;
    min-width: 0;
    -unity-text-align: middle-center;
    padding-left: 8px;
    padding-right: 8px;
}

.AuthMessageError {
    color: rgb(255, 51, 51);
    display: none;
    font-size: 90%;
    align-self: center;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 85%;
    flex-shrink: 1;
}

.AuthFormButton {
    width: 85%;
    align-self: center;
    flex-shrink: 1;
}

.AuthChangeButton {
    -unity-text-align: upper-center;
    align-self: center;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding: 0;
    font-size: 85%;
    white-space: normal;
    flex-shrink: 1;
}

.AuthChangeRow {
    flex-direction: row;
    align-self: center;
    align-items: center;
    flex-shrink: 1;
    width: 85%;                    /* constrain to card width */
    justify-content: center;       /* center the pair horizontally */
    flex-wrap: wrap;               /* wrap if too narrow */
}

.AuthChangeLabel {
    font-size: 85%;
    color: rgb(100, 100, 100);
    white-space: normal;
    flex-shrink: 1;
}

.AuthChangeLinkButton {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(31, 0, 255);
    padding-left: 4px;
    padding-right: 0;
    font-size: 85%;
    flex-shrink: 1;
    white-space: normal;
}

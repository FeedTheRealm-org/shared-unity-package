<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.feed_the_realm.shared/Runtime/UI/AuthFlow/Themes/AuthForm.uss?fileID=7433441132597879392&amp;guid=c25ac5f0ef9fbfd46bdd96a557e53334&amp;type=3#AuthForm"/>
    <ui:VisualElement name="VerifyCodeContainer" class="AuthContainer">
        <ui:VisualElement name="FormVerifyCode" class="formBox">
            <ui:VisualElement name="FormContainer" class="formContainer">
                <ui:Button text="✕" name="Close" class="AuthCloseButton"/>
                <ui:Label text="Verify Your Account" name="FormTitle" class="AuthFormTitle"/>
                <ui:VisualElement name="TitleUnderline" class="AuthFormTitleUnderline"/>
                <ui:VisualElement name="FieldsGroup" class="AuthFieldsGroup">
                    <ui:Label text="enter your code" class="AuthFieldLabel"/>
                    <ui:TextField name="CodeField" class="AuthPasswordField"/>
                </ui:VisualElement>
                <ui:Label name="MessageError" class="AuthMessageError"/>
                <ui:VisualElement name="ResendRow" class="AuthChangeRow" style="justify-content: flex-start; margin-left: 7.5%; align-self: stretch; margin-bottom: 12px;">
                    <ui:Label text="Didn&apos;t get a code? Press" class="AuthChangeLabel"/>
                    <ui:Button text="here" name="RefreshCodeButton" class="AuthChangeLinkButton"/>
                    <ui:Label text="to get a new one" class="AuthChangeLabel"/>
                </ui:VisualElement>
                <ui:Button text="→" name="VerifyCodeButton" class="AuthSubmitButton"/>
                <ui:VisualElement name="BackRow" class="AuthChangeRow">
                    <ui:Label text="Back to" class="AuthChangeLabel"/>
                    <ui:Button text="login" name="LoginBackButton" class="AuthChangeLinkButton"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

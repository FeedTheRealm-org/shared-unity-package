<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.feed_the_realm.shared/Runtime/UI/AuthFlow/Themes/AuthForm.uss?fileID=7433441132597879392&amp;guid=c25ac5f0ef9fbfd46bdd96a557e53334&amp;type=3#AuthForm"/>
    <ui:VisualElement name="LoginContainer" class="AuthContainer">
        <ui:VisualElement name="FormLogin" class="formBox">
            <ui:VisualElement name="FormContainer" class="formContainer">
                <ui:Button text="✕" name="Close" class="AuthCloseButton"/>
                <ui:Label text="Account Login" name="FormTitle" class="AuthFormTitle"/>
                <ui:VisualElement name="TitleUnderline" class="AuthFormTitleUnderline"/>
                <ui:VisualElement name="FieldsGroup" class="AuthFieldsGroup">
                    <ui:Label text="email" class="AuthFieldLabel"/>
                    <ui:TextField name="EmailField" value="" class="AuthEmailInput"/>
                    <ui:Label text="password" class="AuthFieldLabel"/>
                    <ui:TextField name="PasswordField" password="true" value="" class="AuthPasswordField"/>
                </ui:VisualElement>
                <ui:Label name="MessageError" class="AuthMessageError"/>
                <ui:Button text="→" name="LoginButton" class="AuthSubmitButton"/>
                <ui:VisualElement name="ForgotRow" class="AuthChangeRow">
                    <ui:Label text="Forgot your password?" class="AuthChangeLabel"/>
                    <ui:Button text="Recover it here" name="RecoverButton" class="AuthChangeLinkButton"/>
                </ui:VisualElement>
                <ui:VisualElement name="SignUpRow" class="AuthChangeRow">
                    <ui:Label text="Don&apos;t have account?" class="AuthChangeLabel"/>
                    <ui:Button text="Sign up here" name="SignUpChangeButton" class="AuthChangeLinkButton"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
